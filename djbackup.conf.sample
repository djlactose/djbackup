####################################
####################################
# Log file of the backup program
LogFile="/mnt/Backups/.backup.log"
#
# Pid File
pidFile="/var/lock/subsys/djbackup.pid"
#
#Auto Update 0=Off 1=on
AutoUpdate=0
#
#Allow More than one Instance
#NOTE: When this happens the log file will contain entries from both runs.
RunMulti=0
#
#Have missed backups wait until the previous backup finishes instead of skipping it
#NOTE: Run only once has to be turnned off for the que feature to work.
QueBackup=0
#
# Directory where the backup is stored
OutDir="/mnt/Backups/"
#
# This is the base file name of the backup
# NOTE:  Date and time stamp will automatically be added to the begining of this filename
OutFile="$(whoami)HomeDir.$(hostname)"
#
# Directory or Directories to backup.  Each directory should be seperated by a space.
# NOTE:  djbackup's setting directory will automatically be backed up
BkDir="/home/$(whoami)"
####################################
#
####################################
# Encrypt Backup 0 = off 1 = on
# ***Warning turn on encryption will also prevent the log from displaying the files which were backed up
EncryptBackup=0
#
# Passphrase to be used for Encryption
EncryptPassphrase=""
####################################
#
####################################
# Enable differential backup
DiffBackup=0
#
# Day of the week for full backup
# Options: Mon, Tue, Wed, Thu, Fri, Sat, Sun
DiffWkDay="Sun"
####################################
#
####################################
# Use low I/O prioritization and CPU nice 0 = Off
LowPri=0
####################################
#
####################################
# Smooth Backup Writes 0 = Off
mBuffer=0
####################################
#
####################################
# Have Tar skip no-check-devices? 0 = Off
noCheckSkip=0
####################################
#
####################################
# Enable Second Copy 0 = off 1 = on
SecondCopy=0
#
# Device Address
SecondDevice=""
#
# Number of Second Copies to keep 0 = all
SecondCopies=0
####################################
#
####################################
# Copy Backup to the cloud
# Cloud provider to copy backups to: 0 = off, G = Google Cloud Storage (Azure and AWS planned)
# NOTE:  This is kicked off in the background so multiple backups will create multiple uploads.
#        The result of each upload is written to the log when it finishes.
CloudBK="G"
#
# --- Google Cloud (CloudBK=G) ---
# NOTE:  This requires the Google Cloud CLI (gcloud). Standalone gsutil is also supported.
#
# Bucket Name
bucket="bucket_name"
# Folder in the Bucket to upload to (leading and trailing slashes are optional, "/" = top of the bucket)
bucketPath="/"
#
# Service account key file used to upload.  Leave empty to use gcloud's existing login
# (or the VM's attached service account on Google Compute Engine).
# A service account is recommended for unattended backups because it isn't tied to a person's login:
#   1. Create a service account, e.g. djbackup-uploader
#   2. On this bucket only, grant it "Storage Object Creator" (can add files but can't read, overwrite or delete them).
#      If uploads fail with a 403 error use "Storage Object User" instead.
#   3. Create a JSON key for it, save it here, then: chown root:root <file>; chmod 600 <file>
#      If key creation is disabled, your organization enforces iam.disableServiceAccountKeyCreation
#      and an org admin needs to allow it for the project.
#   4. Optional: add bucket lifecycle rules to delete old backups, and djbackup-check/ test files after 1 day.
# NOTE:  /etc/djbackup is included in every backup, so the key is too.  Keep EncryptBackup=1 when uploading.
# Run "djbackup -k" to test the upload.
gcsKeyFile=""
####################################
#
####################################
# Enable Recent backup remote storage through rsync.  0 = off 1 = on
RemoteCopy=0
#
# Remote Username
RemoteUsername=""
#
# Remote Server
RemoteServer=""
#
# Remote Path on server
RemoteDevice=""
####################################
#
####################################
# Automatically clean-up the backup directory. 0 = off 1 = on
Cleanup=1
#
# Keep the five most recent files in the backup directory
RemoveCount=5
####################################
#
####################################
# Do a mysql dump before backup 0 = off 1 = on
MySQLDump=0
#
# Username
MySQLUser=""
#
#Password
MySQLPassword=""
#
# Location of Dump File
MySQLLocation=/etc/djbackup/db_backup.sql
####################################
#
####################################
# Backup Installed RPM List (RHEL based OSes) 0 = off 1 = on
RPMBackup=0
#
# Where to backup RPM List to
RPMFile="/etc/djbackup/installedRPMs.txt"
####################################
#
####################################
# Backup Installed dpkg (Debian based systems) 0 = off 1 = on
dpkgBackup=0
#
# Where to backup dpkg list
dpkgFile="/etc/djbackup/installed_dpkg.txt"
####################################
#
####################################
# Backup Cron 0 = off 1 = on
CronBackup=0
####################################
#
####################################
# Docker Backup settings
# 
# Backup Docker Service Configurations
DockerSwarm=0
#
# Docker Container Configuration Backup
DockerContainer=0
####################################
#
####################################
# Enable Emailing of Report
EmailReport=0
#
# Email address to email report
EmailTo=""
####################################
#
####################################
# Run a command before backup starts
preCom=""
#
# Run a command when backup is done
postCom=""
####################################
####################################
