#!/usr/bin/bash
. /etc/djbackup/djbackup.conf

#Cron runs with a minimal PATH, so add common install locations for cloud tools
PATH="$PATH:/usr/local/bin:/snap/bin:/usr/lib/google-cloud-sdk/bin:/opt/google-cloud-sdk/bin:$HOME/google-cloud-sdk/bin"

#Returns true if a command is installed
hasCmd(){
  command -v "$1" >/dev/null 2>&1
}

#Copy a file to Google Cloud Storage with the configured tool and credentials
#Parallel composite uploads are off because they need delete permission to clean up their temporary parts
gcsCopy(){
  if [ "$gcsTool" = "gcloud" ]
  then
    CLOUDSDK_STORAGE_PARALLEL_COMPOSITE_UPLOAD_ENABLED=False \
      gcloud storage cp ${gcsKeyFile:+--credential-file-override="$gcsKeyFile"} "$1" "$2"
  elif [ -n "$gcsKeyFile" ]
  then
    CLOUDSDK_PASS_CREDENTIALS_TO_GSUTIL=false \
      gsutil -o "Credentials:gs_service_key_file=$gcsKeyFile" -o "GSUtil:parallel_composite_upload_threshold=0" cp "$1" "$2"
  else
    gsutil -o "GSUtil:parallel_composite_upload_threshold=0" cp "$1" "$2"
  fi
}

#Run a cloud upload in the background and log the result to the permanent log
cloudUpload(){
  local desc="$1"; shift
  ( if "$@"; then echo "$(date) Cloud upload completed: $desc"
    else echo "$(date) Cloud upload FAILED: $desc"; fi ) >>"$permLog" 2>&1 &
}

checkAppUpdate(){
  if ! hasCmd curl || ! hasCmd md5sum
  then
    echo "curl and md5sum are required to check for updates, skipping update check."
    return
  fi
  #Download script from Github
  md5=`md5sum $0 |cut -d " " -f 1`
  curl -o /tmp/djbackup https://raw.githubusercontent.com/djlactose/djbackup/master/djbackup
  #has file
  if [ -f "/tmp/djbackup" ]
  then
    newmd5=`md5sum /tmp/djbackup |cut -d " " -f 1`
  else
    newmd5=$md5
  fi
  #Compare hashes to see if they are different
  if [ "$newmd5" != "$md5" ]
  then
    if grep -q https://raw.githubusercontent.com/djlactose/djbackup/master/djbackup "/tmp/djbackup"; then
      chmod --reference=$0 /tmp/djbackup
      chown --reference=$0 /tmp/djbackup
      mv /tmp/djbackup $0.tmp
    else
      echo "Invald app file, ignoring it."
    fi
  else
    if [ -f "/tmp/djbackup" ]
    then
      echo ""
      echo "No Application Update found"
      rm /tmp/djbackup
    fi
  fi
  #Install new script
  if [ -f "$0.tmp" ]
  then
    echo ""
    echo "Application Update found, applying update"
    rm $0
    mv $0.tmp $0
  fi
}  

checkConfUpdate(){
  if ! hasCmd curl || ! hasCmd md5sum
  then
    return
  fi
  #Download config from Github to tmp directory
  md5=`md5sum /etc/djbackup/djbackup.conf.sample |cut -d " " -f 1`
  curl -o /tmp/djbackup.conf.sample https://raw.githubusercontent.com/djlactose/djbackup/master/djbackup.conf.sample
  #has file
  if [ -f "/tmp/djbackup.conf.sample" ]
  then
    newmd5=`md5sum /tmp/djbackup.conf.sample |cut -d " " -f 1`
  else
    newmd5=$md5
  fi
  #Compare hashes to see if they are different
  if [ "$newmd5" != "$md5" ]
  then
    if grep -q LogFile= "/tmp/djbackup.conf.sample"; then
      chmod --reference=/etc/djbackup/djbackup.conf.sample  /tmp/djbackup.conf.sample
      chown --reference=/etc/djbackup/djbackup.conf.sample /tmp/djbackup.conf.sample
      mv /tmp/djbackup.conf.sample /etc/djbackup/djbackup.conf.sample.tmp
    else
      echo "Invald sample config, ignoring it."
    fi
  else
    if [ -f "/tmp/djbackup.conf.sample" ]
    then
      echo ""
      echo "No Sample Config Update found"
      rm /tmp/djbackup.conf.sample
    fi
  fi
  #Install new script
  if [ -f "/etc/djbackup/djbackup.conf.sample.tmp" ]
  then
    echo ""
    echo "Config sample Update found, applying update"
    rm /etc/djbackup/djbackup.conf.sample
    mv /etc/djbackup/djbackup.conf.sample.tmp /etc/djbackup/djbackup.conf.sample
  fi
}

BaseFilename=$OutFile
OutFile=$(date +%Y%m%d)$OutFile
BkDir="$BkDir /etc/djbackup"
SwarmBK="/etc/djbackup/docker_swarm_bk.json"
ContainerBK="/etc/djbackup/docker_container_bk.json"
weekDay=$(date|cut -d " " -f 1)
CheckOnly=0

while [ $# -gt 0 ]
do
  key="$1"
  case $key in
  -c|--nocloud) #Don't backup to the cloud
    CloudBK=0
    shift
    ;;
  -C|--nocron) #Don't backup cron
    CronBackup=0
    shift
    ;;
  -e|--noencrypt) #Don't encrypt the backup
    EncryptBackup=0
    shift
    ;;
  -k|--check) #Check that dependencies for enabled features are installed
    CheckOnly=1
    shift
    ;;
  -f|--full) #Run a full backup
    DiffBackup=0
    shift
    ;;
  -m|--nomysql) #Don't backup MySQL/MariaDB
    MySQLDump=0
    shift
    ;;
  -r|--norpm) #Don't backup Installed RPMs
    RPMBackup=0
    shift
    ;;
  -s|--nosecond) #Don't make a second copy
    SecondCopy=0
    shift
    ;;
  -u|--update) #Check for updates
    checkAppUpdate
    checkConfUpdate
    exit 0
    ;;
  -x|--nocleanup) #Don't cleanup old backups
    Cleanup=0
    shift
    ;;
  *)
    echo "Usage: $0 [-c] [-C] [-e] [-f] [-k] [-m] [-r] [-s] [-u] [-x]

-c | --nocloud     Run backup but don't send it to the cloud
-C | --nocron      Run backup but don't backup cron
-e | --noencrypt   Run backup but don't encrypt it
-f | --full        Run a full backup
-k | --check       Check that everything needed by the enabled features is installed, without running a backup
-m | --nomysql     Run backup but don't backup mysql
-r | --norpm       Run backup but don't backup the rpm list
-s | --nosecond    Run backup but don't copy the backup to the second location
-u | --update      Checks for updates to the script
-x | --nocleanup   Run backup but don't remove old copies"
    exit 1
    ;;
  esac
done

#Dependency Check: turn off any feature whose command isn't installed
depWarnings=()
depErrors=()
missingDep(){
  depWarnings+=("WARNING: $1 is not installed, $2")
}

if ! hasCmd tar
then
  depErrors+=("ERROR: tar is not installed, unable to run backup.")
fi

if hasCmd pigz
then
  compressCmd="pigz -6"
elif hasCmd gzip
then
  compressCmd="gzip -6"
  missingDep pigz "using gzip instead (slower)."
else
  depErrors+=("ERROR: Neither pigz nor gzip is installed, unable to compress backup.")
fi

if [ "$EncryptBackup" -eq "1" ] && ! hasCmd gpg
then
  EncryptBackup=0
  missingDep gpg "backup will NOT be encrypted. Remote and cloud copies are skipped so the unencrypted backup stays on this machine."
  RemoteCopy=0
  CloudBK=0
fi

if [ "${LowPri:-0}" -eq "1" ]
then
  for cmd in nice ionice
  do
    hasCmd $cmd || missingDep $cmd "backup will run without it."
  done
fi

if [ "${mBuffer:-0}" -eq "1" ] && ! hasCmd mbuffer
then
  mBuffer=0
  missingDep mbuffer "backup writes will not be buffered."
fi

if [ "$dpkgBackup" -eq "1" ] && ! hasCmd apt
then
  dpkgBackup=0
  missingDep apt "skipping installed package list."
fi

if [ "$RPMBackup" -eq "1" ] && ! hasCmd rpm
then
  RPMBackup=0
  missingDep rpm "skipping installed RPM list."
fi

if [ "$MySQLDump" -eq "1" ] && ! hasCmd mysqldump
then
  MySQLDump=0
  missingDep mysqldump "skipping MySQL backup."
fi

if { [ "$DockerSwarm" -eq "1" ] || [ "$DockerContainer" -eq "1" ]; } && ! hasCmd docker
then
  DockerSwarm=0
  DockerContainer=0
  missingDep docker "skipping Docker configuration backup."
fi

if [ "$RemoteCopy" -eq "1" ] && ! hasCmd rsync
then
  RemoteCopy=0
  missingDep rsync "skipping remote copy."
fi

if [ "$CloudBK" = "G" ]
then
  #Prefer gcloud storage, fall back to gsutil for older or standalone installs
  if hasCmd gcloud && gcloud storage cp --help >/dev/null 2>&1 </dev/null
  then
    gcsTool="gcloud"
  elif hasCmd gsutil
  then
    gcsTool="gsutil"
  else
    CloudBK=0
    missingDep "gcloud/gsutil" "skipping Google Cloud copy."
  fi
  if [ "$CloudBK" = "G" ] && [ -n "$gcsKeyFile" ] && [ ! -r "$gcsKeyFile" ]
  then
    CloudBK=0
    depWarnings+=("WARNING: Google Cloud key file $gcsKeyFile is missing or unreadable, skipping Google Cloud copy.")
  fi
fi

if [ "$EmailReport" -eq "1" ] && ! hasCmd mail
then
  EmailReport=0
  missingDep mail "skipping email report."
fi

#Check mode: report on dependencies for enabled features and exit without running a backup
if [ "$CheckOnly" -eq "1" ]
then
  #Test a real upload, since the service account may only be allowed to create files (not list or read them)
  #Each test file gets a unique name because create-only access can't overwrite
  if [ "$CloudBK" = "G" ]
  then
    testFile=$(mktemp)
    echo "djbackup check $(date)" > "$testFile"
    if ! testOut=$(gcsCopy "$testFile" "gs://$bucket/djbackup-check/$HOSTNAME-$(date +%Y%m%d%H%M%S)-$$" 2>&1 </dev/null)
    then
      testErr=$(echo "$testOut" | grep -i -m1 "error")
      depWarnings+=("WARNING: Cloud upload test to gs://$bucket failed: ${testErr:-$(echo "$testOut" | tail -n1)}")
    fi
    rm -f "$testFile"
  fi
  if [ ${#depErrors[@]} -eq 0 ] && [ ${#depWarnings[@]} -eq 0 ]
  then
    echo "All dependencies for enabled features are installed."
    exit 0
  fi
  printf '%s\n' "${depErrors[@]}" "${depWarnings[@]}" | grep -v '^$'
  exit 1
fi

if [ ${#depErrors[@]} -gt 0 ]
then
  printf '%s\n' "${depErrors[@]}" | tee -a $LogFile
  exit 1
fi

#Pid File Check
if [ -f "$pidFile" ] && [ "$RunMulti" -ne 1 ]
then
  runningPid=$(cat "$pidFile")
  if [ -n "$runningPid" ] && kill -0 "$runningPid" 2>/dev/null
  then
	  echo "Backup Already in progress"
    echo "Another Backup couldn't start at " $(date) | tee -a $LogFile
	  if [ "$QueBackup" -ne 1 ]
    then
      exit 1
    else
      echo "Queuing new backup" | tee -a $LogFile
      while kill -0 "$runningPid" 2>/dev/null
      do
        sleep 300
      done
    fi
  else
	  rm $pidFile
  fi
fi

#Run pre-execution command before backup
$($preCom)

#Email Report start writting out to a temp file to be able to send the report
if [ "$EmailReport" -eq "1" ]
then
	TmpLog=$LogFile
	LogFile="/tmp/tmp.log"
fi
#Background jobs that finish after the email is sent write to the real log
permLog="${TmpLog:-$LogFile}"

#Start of report formating
echo "*****************************************************************" | tee -a $LogFile
echo "*****************************************************************" | tee -a $LogFile
echo "" | tee -a $LogFile
date | tee -a $LogFile
echo "" | tee -a $LogFile
echo "" | tee -a $LogFile

#Report any missing dependencies
if [ ${#depWarnings[@]} -gt 0 ]
then
    for warning in "${depWarnings[@]}"
    do
        echo "$warning" | tee -a $LogFile
    done
    echo "" | tee -a $LogFile
fi


#Backup Code started
echo $$ > $pidFile
echo "" | tee -a $LogFile
echo "Output file: " | tee -a $LogFile
echo "" | tee -a $LogFile


#Installed RPM List Generation
if [ "$dpkgBackup" -eq "1" ]
then
        apt list --installed > $dpkgFile
fi

#Installed dpkg
if [ "$RPMBackup" -eq "1" ]
then
        rpm -qa > $RPMFile
fi

#MySQL Backup started
if [ "$MySQLDump" -eq "1" ] 
then
    echo "Starting Dump of MySQL Databases..." | tee -a $LogFile
    mysqldump --user=$MySQLUser --password=$MySQLPassword -A > $MySQLLocation
    chmod 700 $MySQLLocation
    echo "Done Dumping MySQL Databases..." | tee -a $LogFile
    echo "" | tee -a $LogFile
fi

#Cron Backup Started
if [ "$CronBackup" -eq "1" ]
then
    echo "Adding Cron Files to backup list..." | tee -a $LogFile
    BkDir="$BkDir /var/spool/cron/"
    echo "" | tee -a $LogFile
fi

#Docker Swarm Backup Started
if [ "$DockerSwarm" -eq "1" ]
then
    echo "Adding Docker Swarm Configuration Files to backup list..." | tee -a $LogFile
    docker service ls -q | xargs docker service inspect > $SwarmBK
    echo "" | tee -a $LogFile
fi

#Docker Container Backup Started
if [ "$DockerContainer" -eq "1" ]
then
    echo "Adding Docker Container Configuration Files to backup list..." | tee -a $LogFile
    docker service ls -q | xargs docker service inspect > $ContainerBK
    echo "" | tee -a $LogFile
fi

#This will check if differential backup is on and then run one if it is.
if [ "$DiffBackup" -eq "1" ]
then
    #Checks the current day of the week to see if it is the day the differential is supposed to be run
    weekDay=$(date|cut -d " " -f 1)
    if [ "$weekDay" = "$DiffWkDay" ]
    then
         parms="-g /etc/djbackup/filelist.txt --level=0"
         OutFile=$OutFile.full
    else
         parms="-g /etc/djbackup/filelist.txt --level=1"
         OutFile=$OutFile.inc
    fi
else
    parms=""
fi
# Tells tar “Don’t verify that device IDs (st_dev) match previous backups.” if option is set
if [ "${noCheckSkip:-0}" -eq "1" ]
then
    parms="--no-check-device $parms"
fi

parms="--warning=no-file-changed --ignore-failed-read $parms"

if [ "${LowPri:-0}" -eq "1" ]
then
    preTar=""
    hasCmd nice && preTar="$preTar nice -n19"
    hasCmd ionice && preTar="$preTar ionice -c3"
else
    preTar=""
fi

#Optionally buffer the tar stream to smooth out writes
bufferStream(){
  if [ "${mBuffer:-0}" -eq "1" ]
  then
    mbuffer -q -m 2G
  else
    cat
  fi
}

if [ "$EncryptBackup" -eq "1" ]
then
    echo "Backing up $BkDir" | tee -a $LogFile
    echo $EncryptPassphrase > /etc/djbackup/.encrypt_pass
    chmod 700 /etc/djbackup/.encrypt_pass
    OutFile=$OutFile.tgz.gpg
    if [ -f "$OutDir$OutFile" ]
    then
	      OutFile=$OutFile.$(date +%H%M%S)
    fi
    $preTar tar $parms -pc $BkDir | bufferStream | $compressCmd | gpg --batch --passphrase-file=/etc/djbackup/.encrypt_pass -c -o $OutDir$OutFile
    rm /etc/djbackup/.encrypt_pass
else
    echo "Backing up $BkDir" | tee -a $LogFile
    OutFile=$OutFile.tgz
    if [ -f "$OutDir$OutFile" ]
    then
        OutFile=$OutFile.$(date +%H%M%S)
    fi
    #With the archive on stdout, tar writes the verbose file list to stderr, so send that to the log
    $preTar tar $parms -pcv -f - $BkDir 2> >(tee -a $LogFile) | bufferStream | $compressCmd > $OutDir$OutFile
fi
echo "" | tee -a $LogFile
echo "Backup completed:" | tee -a $LogFile
date | tee -a $LogFile
echo "" | tee -a $LogFile
rm $pidFile
#####################################################
#####################################################
#####################################################

#Create remote copy
if [ "$RemoteCopy" -eq "1" ] 
then
    echo "Remote Copy Starting..." | tee -a $LogFile
    rsync -az $OutDir$OutFile $RemoteUsername@$RemoteServer:$RemotePath/$OutFile | tee -a $LogFile
    echo "" | tee -a $LogFile
fi

#Google Cloud Bucket Copy
if [ "$CloudBK" = "G" ]
then
    echo "Cloud Backup Starting in background..." | tee -a $LogFile
    #Always name the object explicitly so each backup is its own file, whatever slashes bucketPath has
    gcsFolder=${bucketPath#/}
    gcsFolder=${gcsFolder%/}
    if [ -n "$gcsFolder" ]
    then
      gcsDest="gs://$bucket/$gcsFolder/$OutFile"
    else
      gcsDest="gs://$bucket/$OutFile"
    fi
    cloudUpload "$gcsDest" gcsCopy "$OutDir$OutFile" "$gcsDest"
fi

#Create second local copy
if [ "$SecondCopy" -eq "1" ]
then
    cp -p $OutDir$OutFile $SecondDevice
    echo "" | tee -a $LogFile
    echo "Copied $OutDir$OutFile to $SecondDevice." | tee -a $LogFile
    Count=1
    echo "" | tee -a $LogFile
    echo "Cleaning Up Old Second Backups..." | tee -a $LogFile
    echo "" | tee -a $LogFile
    echo "Removed the Following Second Backups:" | tee -a $LogFile
    for file in $(ls -t $SecondDevice | grep -v lost |grep $BaseFilename); do
	if [ "$Count" -gt "$SecondCopies" ]
	then
	    echo $file | tee -a $LogFile
	    rm -f $SecondDevice/$file | tee -a $LogFile
	fi
	let Count++
    done
fi

#Clean up RPM Backup
if [ "$RPMBackup" -eq "1" ]
then
    rm $RPMFile
fi

#Clean up dpkg Backup
if [ "$dpkgBackup" -eq "1" ]
then
    rm $dpkgFile
fi

#Clean up mySQL backup
if [ "$MySQLDump" -eq "1" ] 
then
    rm $MySQLLocation
fi

#Clean up mySQL backup
if [ "$DockerSwarm" -eq "1" ] 
then
    rm $SwarmBK
fi

#Clean up mySQL backup
if [ "$DockerContainer" -eq "1" ] 
then
    rm $ContainerBK
fi

#Cleanup backups
if [ "$Cleanup" -eq "1" ] 
then
    Count=1
    echo "" | tee -a $LogFile
    echo "Cleaning Up Old Backups..." | tee -a $LogFile
    echo "" | tee -a $LogFile
    echo "Removed the Following Backups:" | tee -a $LogFile
    if [ "$DiffBackup" -eq "1" ]
    then
        #Checks the current day of the week to see if it is the day the differential is supposed to be run
        if [ "$weekDay" = "$DiffWkDay" ]
        then
	  for file in $(ls -t $OutDir | grep -v lost | grep $BaseFilename); do
            if [ "$Count" -gt "$RemoveCount" ]
            then
                echo $file | tee -a $LogFile
                rm -f $OutDir$file | tee -a $LogFile
            fi
            let Count++
          done
	else
	  for file in $(ls -t $OutDir | grep -v lost |grep -v full | grep $BaseFilename); do
            if [ "$Count" -gt "$RemoveCount" ]
            then
               echo $file | tee -a $LogFile
       	       rm -f $OutDir$file | tee -a $LogFile
       	     fi
       	     let Count++
          done
        fi
    else
	for file in $(ls -t $OutDir | grep -v lost | grep $BaseFilename); do
	  if [ "$Count" -gt "$RemoveCount" ]
	  then
	      echo $file | tee -a $LogFile
	      rm -f $OutDir$file | tee -a $LogFile
	  fi
	  let Count++
	done
    fi
fi


#Log Formating of ending
echo "" | tee -a $LogFile
echo "" | tee -a $LogFile
echo "Finished at: " | tee -a $LogFile
date | tee -a $LogFile
echo "" | tee -a $LogFile
echo "*****************************************************************" | tee -a $LogFile
echo "*****************************************************************" | tee -a $LogFile


#Create email and send it out using the temp file that was created
if [ "$EmailReport" -eq "1" ]
then
	cat $LogFile | mail -s "Backup Report" $EmailTo
	cat $LogFile >> $TmpLog
	rm $LogFile
fi

#Run Post-processing command
$($postCom)

#Check for updates if on
if [ "$AutoUpdate" -eq "1" ]
then
  checkAppUpdate
  checkConfUpdate
fi